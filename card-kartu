[ card Posisinya bisa diatur bebas (dipindah-pindah), ]

index.html 
<body>
    <div class="card">
    </div>
</body>




style.css
body {
    margin: 0;
    min-height: 100vh;
    background: rgba(147, 147, 202, 0.467);
    position: relative;
}

.card {
    position: absolute;
    top: 200px;
    left: 400px;
    width: 400px;
    height: 100px;
    background-color: hsl(36, 100%, 90%);
    border-radius: 16px;
}




















