style.css
:root {
    --text: #1a1a1a;
}
/* buat variabel warna untuk teks agar mudah diubah nanti jika ingin ganti tema */

.logo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 36px;
}
/* buat logo dan nama aplikasi di bagian atas halaman utama */

.logo svg {
    flex-shrink: 0;
}
/* buat logo agar tidak mengecil saat halaman di-resize */

.logo-text {
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -.4px;
}
/* buat nama aplikasi dengan ukuran font yang lebih besar dan tebal, serta warna yang diambil dari variabel --text */

